# wake_sdk(交付包_Wake_v1) - 语音唤醒+实时对话+Function Calling(my_wake)
#
# 用户态独立程序,与 my_audio 同层级,直接调 HI_MPI_AI + /dev/acodec,不依赖 media_server。
# 16kHz 采样,TFLM 软推理 + microfrontend 前端,Luna 唤醒词模型。
#
# 串口用法:
#   exec /bin/my_wake
#
# 链接说明:同 my_audio,rootfs 不带 libmpi.so,必须静态链 mpp 的 .a。
#
# TFLM vendoring 策略(见 SPEC.md 3.3 节):
#   - 核心 micro/*.cc 全编译,用 reference micro_time.cc(非 esp/)
#   - kernels/*.cc reference 全编译,跳过 esp_nn/(ESP 加速内核)和 test 文件
#   - microfrontend 纯 C,全编译(kiss_fft.cc/kiss_fftr.cc 被 kiss_fft_int16.cc 文本包含,不单编)
#   - flatbuffers 用 TFLM 自带的(25.9.23,树里是 25.2.10,版本不兼容)
import("//build/lite/config/component/lite_component.gni")

sdk_liteos_root = "//device/soc/hisilicon/hi3516dv300/sdk_liteos"
tflm = "tflm"
mf = "microfrontend"

