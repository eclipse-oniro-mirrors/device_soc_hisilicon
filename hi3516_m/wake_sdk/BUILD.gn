# 说明(本副本, applications/agent_test/wake_sdk):
#   这里只保留 wake_audio_core 源集, 供同包 app_test 副本(dep 引用)复用;
#   不再定义 executable("wake")/lite_component("wake_sdk") —— 与原
#   applications/wake_sdk 组件的输出 my_wake 同名, 会产生 GN output collision。
#   my_wake 独立程序仍由原组件构建, 本目录不重复链接。

# 音频核心编译单元: app_test 语音集成经 dep 复用。
# 源清单 = wake_core_srcs(与原 :wake 完全一致); 编译选项照抄原 :wake 的 TFLM 配置。
source_set("wake_audio_core") {
  sources = wake_core_srcs
  include_dirs = [
    "$sdk_liteos_root/include",
    "//third_party/bounds_checking_function/include",
    "//third_party/mbedtls/include",
    ".",                        # wake_*.h
    "tflm",
    "tflm/third_party/flatbuffers/include",
    "tflm/third_party/gemmlowp",
    "tflm/third_party/ruy",
    "tflm/third_party/kissfft",
    "microfrontend",
    "microfrontend/kissfft",
  ]
  cflags = [
    "-DTF_LITE_STATIC_MEMORY",
    "-DTF_LITE_DISABLE_X86_NEON",
    "-O2",
    "-ffunction-sections",
    "-fdata-sections",
    "-fPIC",
    "-Wno-unused-parameter",
    "-Wno-sign-compare",
    "-Wno-missing-field-initializers",
    "-Wno-double-promotion",
    "-Wno-unused-function",
    "-Wno-type-limits",
    "-Wno-strict-aliasing",
  ]
  cflags_cc = cflags + [ "-fno-rtti", "-fno-exceptions", "-fno-threadsafe-statics", "-std=c++11" ]
}

group("wake_group") {
  deps = [ ":wake_audio_core" ]
}
